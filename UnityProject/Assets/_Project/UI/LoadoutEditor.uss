/* スキル編成画面(LoadoutEditor.uxml) */

.editor {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.editor__window {
    position: absolute;
    left: 48px;
    top: 36px;
    right: 48px;
    bottom: 36px;
    padding: 22px 26px 16px 26px;
    border-radius: 14px;
}

.editor__header {
    flex-direction: row;
    align-items: center;
}

.editor__title {
    font-size: 34px;
}

.editor__spacer {
    flex-grow: 1;
}

.editor__collect {
    font-size: 20px;
    color: var(--bf-text-sub);
    margin-right: 18px;
}

.editor__mode {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
}

.editor__mode-label {
    font-size: 17px;
    color: var(--bf-text-sub);
    margin-right: 10px;
}

.editor__mode-button {
    margin-left: 8px;
    min-width: 170px;
}

.editor__close {
    min-width: 170px;
}

.editor__notice {
    font-size: 17px;
    color: var(--bf-gold);
    margin-top: 8px;
}

.editor__body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 16px;
}

.editor__section {
    font-size: 19px;
    color: var(--bf-text-sub);
    margin-bottom: 8px;
}

/* ---------- 左: プリセット ---------- */

.editor__presets {
    width: 300px;
    margin-right: 20px;
}

/* カード(とテンプレートの入れ物)は縮めない。縮むと見出しと中身が重なる */
.editor__presets > TemplateContainer,
.preset-card,
.preset-card__head {
    flex-shrink: 0;
}

.preset-card {
    background-color: var(--bf-card);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--bf-line);
    border-left-width: 5px;
    padding: 6px 12px;
    margin-bottom: 7px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.preset-card:hover {
    background-color: var(--bf-card-hover);
}

.preset-card--editing {
    background-color: rgba(47, 127, 216, 0.22);
    border-right-color: #6FC3FF;
    border-top-color: #6FC3FF;
    border-bottom-color: #6FC3FF;
}

.preset-card__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.preset-card__number {
    font-size: 20px;
    margin-right: 10px;
    color: var(--bf-text-sub);
}

.preset-card__title {
    font-size: 19px;
    flex-grow: 1;
}

.preset-card__in-use {
    font-size: 14px;
    color: #0B1220;
    background-color: var(--bf-accent);
    border-radius: 4px;
    padding: 0 6px;
}

.preset-card__skill {
    font-size: 14px;
    margin: 0;
    padding: 0 2px;
}

.preset-card__bonus {
    font-size: 13px;
    color: var(--bf-gold);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
}

.editor__presets-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.editor__presets-head > .editor__section {
    margin-bottom: 0;
}

.editor__reset {
    font-size: 15px;
    padding: 4px 12px;
}

/* ---------- 中央: スキルの一覧 ---------- */

.editor__lists {
    flex-direction: row;
    flex-grow: 1;
}

.editor__column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.skill-list {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 10px;
    padding: 6px;
}

/* スクロールバーは細く、矢印ボタンは出さない */
.skill-list .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.skill-list .unity-scroller__low-button,
.skill-list .unity-scroller__high-button {
    display: none;
}

.skill-list .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 4px;
}

.skill-list .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.28);
    border-width: 0;
    border-radius: 4px;
    left: 1px;
    right: 1px;
}

.skill-group {
    flex-direction: row;
    align-items: center;
    margin: 8px 4px 4px 4px;
}

.skill-group__dot {
    width: 6px;
    height: 16px;
    border-radius: 3px;
    margin-right: 8px;
}

.skill-group__name {
    font-size: 17px;
}

.skill-row {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 12px;
    margin: 2px 0;
    border-radius: 7px;
    background-color: var(--bf-card);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.skill-row:hover {
    background-color: var(--bf-card-hover);
    border-color: rgba(255, 255, 255, 0.18);
}

.skill-row--selected {
    background-color: rgba(47, 127, 216, 0.30);
}

.skill-row__name {
    font-size: 17px;
    flex-grow: 1;
}

.skill-row__check {
    font-size: 15px;
    color: var(--bf-accent);
}

.skill-row--locked {
    background-color: rgba(255, 255, 255, 0.015);
}

.skill-row--locked:hover {
    background-color: rgba(255, 255, 255, 0.015);
    border-color: rgba(0, 0, 0, 0);
}

.skill-row--locked > .skill-row__name {
    color: var(--bf-text-dim);
}

/* ---------- 右: 名前と詳細 ---------- */

.editor__detail {
    width: 380px;
}

.editor__name {
    margin: 0 0 12px 0;
    font-size: 22px;
}

.editor__name > .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: var(--bf-line);
    border-radius: 8px;
    color: var(--bf-text);
    padding: 6px 10px;
}

.detail {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 10px;
    padding: 16px 18px;
}

.detail__empty {
    font-size: 18px;
    color: var(--bf-text-dim);
    white-space: normal;
}

.detail__name {
    font-size: 32px;
}

.detail__meta {
    font-size: 16px;
    color: var(--bf-text-sub);
    margin-top: 4px;
}

.detail__desc {
    font-size: 17px;
    white-space: normal;
    margin-top: 12px;
}

.detail__stats {
    margin-top: 14px;
}

.detail__stat {
    font-size: 16px;
    color: #CFE3FF;
    margin: 2px 0;
}

.detail__caption {
    font-size: 15px;
    color: var(--bf-text-dim);
}

.detail__bonus {
    font-size: 18px;
    color: var(--bf-gold);
    white-space: normal;
    margin-top: 4px;
}

.editor__footer {
    font-size: 16px;
    color: var(--bf-text-dim);
    margin-top: 12px;
}
