  - Key: select.slot.switched
    Text: "\u30B9\u30ED\u30C3\u30C8{0} \u306B\u5207\u308A\u66FF\u3048\u307E\u3057\u305F"
  - Key: select.slot.is_empty
    Text: "\u30B9\u30ED\u30C3\u30C8{0} \u306F\u7A7A\u304D\u3067\u3059"
  - Key: select.slot.delete.title
    Text: "\u30B9\u30ED\u30C3\u30C8{0} \u3092\u6D88\u3057\u307E\u3059\u304B?"
  - Key: select.slot.delete.text
    Text: "\u63A2\u7D22\u306E\u8A18\u9332\u30FB\u30B9\u30AD\u30EB\u7DE8\u6210\u30FB\u30B9\u30C6\u30FC\u30B8\u306E\u8A18\u9332\u3092\u3059\u3079\u3066\u6D88\u3057\u307E\u3059\u3002\u5143\u306B\u306F\u623B\u305B\u307E\u305B\u3093\u3002"
  - Key: select.slot.deleted
    Text: "\u30B9\u30ED\u30C3\u30C8{0} \u3092\u6D88\u3057\u307E\u3057\u305F"
  - Key: select.start_over
    Text: "\u306F\u3058\u3081\u304B\u3089"
  - Key: select.start_over.title
    Text: "\u63A2\u7D22\u3092\u306F\u3058\u3081\u304B\u3089\u306B\u3057\u307E\u3059\u304B?"
  - Key: select.start_over.text
    Text: "\u30B9\u30ED\u30C3\u30C8{0} \u306E\u63A2\u7D22\u306E\u8A18\u9332(\u96C6\u3081\u305F\u30B9\u30AD\u30EB\u30FB\u958B\u3051\u305F\u9053\u30FB\u796D\u58C7\u30FB\u63A2\u7D22\u306E\u7DE8\u6210)\u3092\u6D88\u3057\u307E\u3059\u3002\u5143\u306B\u306F\u623B\u305B\u307E\u305B\u3093\u3002"
  - Key: select.start_over.done
    Text: "\u63A2\u7D22\u306E\u8A18\u9332\u3092\u6D88\u3057\u307E\u3057\u305F\u3002\u306F\u3058\u3081\u304B\u3089\u904A\u3079\u307E\u3059"
  - Key: select.footer
    Text: "\u30AF\u30EA\u30C3\u30AF / Enter(A\u30DC\u30BF\u30F3)\u3067\u958B\u59CB  
      W\u30FBS / \u5341\u5B57\u30AD\u30FC\u3067\u9078\u629E   Q\u30FBE(LB\u30FBRB)\u3067\u30B9\u30ED\u30C3\u30C8  
      [P] \u30B9\u30AD\u30EB\u7DE8\u6210   [O] \u8A2D\u5B9A"
  - Key: select.footer.start_over
    Text: "   [Backspace] \u63A2\u7D22\u3092\u306F\u3058\u3081\u304B\u3089"
  - Key: select.record.training
    Text: "\u7DF4\u7FD2\u7528"
  - Key: select.record.exploration
    Text: "{0}\u30B9\u30AD\u30EB {1} / {2}"
  - Key: select.record.cleared_mark
    Text: "\u30AF\u30EA\u30A2\u6E08\u307F  "
  - Key: select.record.endless
    Text: "\u6700\u9AD8 WAVE {0}"
  - Key: select.record.none
    Text: "\u8A18\u9332\u306A\u3057"
  - Key: select.record.not_cleared
    Text: "\u672A\u30AF\u30EA\u30A2"
  - Key: select.record.cleared
    Text: "\u30AF\u30EA\u30A2\u6E08\u307F  {0:0.0}\u79D2 / {1}"
