root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
max_line_length = 140

# ---- フォーマット(Docs/CodingRules.md 6章) ----
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
dotnet_sort_system_directives_first = true
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:silent

# ---- 名前のルール(Docs/CodingRules.md) ----

# 外部に公開する変数: PascalCase
dotnet_naming_symbols.public_members.applicable_kinds = field, property, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal
dotnet_naming_rule.public_members_pascal.severity = warning

# それ以外のメンバー変数(private。SerializeField・static・readonly・const も含む): m + PascalCase
dotnet_naming_symbols.private_members.applicable_kinds = field, property
dotnet_naming_symbols.private_members.applicable_accessibilities = private
dotnet_naming_rule.private_members_m.symbols = private_members
dotnet_naming_rule.private_members_m.style = m_prefix
dotnet_naming_rule.private_members_m.severity = warning

# ローカル変数: a + PascalCase
dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_rule.locals_a.symbols = locals
dotnet_naming_rule.locals_a.style = a_prefix
dotnet_naming_rule.locals_a.severity = warning

# 引数: i / o / io は ref・out を見分けられないので、IDE ではチェックしない(レビューで確かめる)

# 型・メソッド: PascalCase
dotnet_naming_symbols.types_and_methods.applicable_kinds = class, struct, interface, enum, delegate, method, local_function
dotnet_naming_rule.types_and_methods_pascal.symbols = types_and_methods
dotnet_naming_rule.types_and_methods_pascal.style = pascal
dotnet_naming_rule.types_and_methods_pascal.severity = warning

dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_style.m_prefix.required_prefix = m
dotnet_naming_style.m_prefix.capitalization = pascal_case

dotnet_naming_style.a_prefix.required_prefix = a
dotnet_naming_style.a_prefix.capitalization = pascal_case
